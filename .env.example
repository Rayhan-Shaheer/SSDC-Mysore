# Copy this file to .env.local and fill in the values from
# https://dashboard.emailjs.com — then restart `npm run dev`.
#
# The same four values must also be added in Vercel:
#   Project Settings -> Environment Variables
#
# Recipients are NOT configured here. The admin notification's To and Cc
# addresses are set on the EmailJS template itself, so they cannot be
# tampered with from the browser or broken by a missing variable.

# Dashboard -> Email Services -> your service
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx

# Dashboard -> Email Templates -> "Admission Inquiry (Admin)"
VITE_EMAILJS_TEMPLATE_ADMIN=template_xxxxxxx

# Dashboard -> Email Templates -> "Admission Inquiry (Applicant Auto-Reply)"
VITE_EMAILJS_TEMPLATE_AUTOREPLY=template_xxxxxxx

# Dashboard -> Account -> General -> Public Key
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxx
